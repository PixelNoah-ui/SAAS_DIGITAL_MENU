# Application
NODE_ENV=development
PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pixelshop

# Authentication
JWT_SECRET=replace-with-a-secure-secret

# Session settings
SESSION_EXPIRE_HOURS=3
SESSION_EXPIRE_MINUTES=15
ORDER_LIMIT_PER_WINDOW=3
ORDER_WINDOW_MINUTES=10

# Email (used for password reset and QR table emails)
EMAIL_HOST=smtp.example.com
EMAIL_USERNAME=admin@example.com
EMAIL_PASSWORD=replace-with-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
