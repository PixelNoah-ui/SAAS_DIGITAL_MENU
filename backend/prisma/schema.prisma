// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderSessionStatus {
  ACTIVE
  EXPIRED
  CLOSED
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Table {
  id            String         @id @default(uuid())
  name          String
  qrToken       String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  orders        Order[]
  orderSessions OrderSession[]

  @@map("tables")
}



model MenuItem {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl      String?
  imagePublicId String?
  category       String
  preparationTime Int     @default(15) // in minutes
  isAvailable  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  orderItems  OrderItem[]

  @@map("menu_items")
}

model Order {
  id             String      @id @default(uuid())
  tableId        String
  orderSessionId String?
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  table        Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orderSession OrderSession? @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([tableId])
  @@index([status])
  @@index([orderSessionId])
  @@map("orders")
}

model OrderSession {
  id           String             @id @default(uuid())
  tableId      String
  sessionToken String             @unique @default(uuid())
  status       OrderSessionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  table  Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tableId])
  @@map("order_sessions")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model AdminUser {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  role                UserRole  @default(STAFF)
  resetToken          String?   @db.Text
  resetTokenExpiry    DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?
  createdAt           DateTime  @default(now())

  @@map("admin_users")
}

model RestaurantInfo {
  id             String   @id @default(uuid())
  name           String   
  phone          String   
  address        String   
  room           String   
  telegramUsername String 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("restaurant_info")
}